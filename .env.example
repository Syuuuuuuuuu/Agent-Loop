# 复制本文件为 .env，并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 豆包（火山引擎 ARK）API 配置
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包模型 Endpoint ID / 模型名（在火山引擎控制台创建推理接入点后获得）
ARK_CHAT_MODEL=your_endpoint_id_here

# 豆包 embedding 模型（multimodal 接口，用于套路库 top-k 语义检索）
ARK_EMBED_MODEL=doubao-embedding-vision-251215

# 套路库每次召回的最相关样本条数（top-k），可选，默认 5
PLAYBOOK_TOP_K=5

# LLM 提供方：mock（离线桩）| ark（真实豆包）
LLM_PROVIDER=mock
